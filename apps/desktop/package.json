{
  "name": "@commit-casino/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:ui": "vite --port 1420 --strictPort",
    "build:ui": "vite build",
    "prepare:helper": "node scripts/prepare-helper.mjs",
    "build:bundle": "npm run prepare:helper && npm run build:ui",
    "dev:bundle": "npm run prepare:helper && npm run dev:ui"
  },
  "dependencies": {
    "@commit-casino/casino-contracts": "*",
    "@commit-casino/game-ui": "*",
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@vitejs/plugin-react": "^5.0.3",
    "vite": "^7.1.7",
    "typescript": "^5.9.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9"
  }
}
