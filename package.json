{
  "name": "commit-casino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:desktop": "node scripts/native.mjs dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages apps tests scripts *.ts *.js",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts",
    "test:e2e": "playwright test",
    "test:native": "node scripts/native.mjs test",
    "lint:native": "node scripts/native.mjs lint",
    "test:ui": "npm run test:browser --workspace @commit-casino/game-ui",
    "test:desktop": "node scripts/native-smoke.mjs",
    "test:installer": "node scripts/installer-smoke.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:desktop": "node scripts/native.mjs build",
    "generate:catalog": "node scripts/generate-catalog.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "pixi.js": "8.22.0",
    "zustand": "5.0.15",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "vitest": "5.0.3",
    "fast-check": "4.10.2",
    "fake-indexeddb": "6.2.5",
    "@playwright/test": "1.64.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0"
  }
}
